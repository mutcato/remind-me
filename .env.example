# ---- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=remindme.nudgewire.com,localhost,127.0.0.1,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=https://remindme.nudgewire.com
LOG_LEVEL=INFO
DATABASE_PATH=data/remindme.db
# Postgres instead of SQLite (optional):
# DATABASE_URL=postgres://user:pass@localhost:5432/remindme

# ---- Meta app / Instagram account ------------------------------------------
# App secret of the Meta app that owns the webhook subscription.
IG_APP_SECRET=changeme
# Random string; must match the "Verify token" typed into the Meta webhook UI.
IG_VERIFY_TOKEN=changeme
# Instagram Professional account id of @remindme.in (the bot account).
IG_USER_ID=17841400000000000
# Long-lived access token for that account.
IG_ACCESS_TOKEN=changeme
# Facebook Login setup -> https://graph.facebook.com
# Instagram Login setup -> https://graph.instagram.com
GRAPH_BASE_URL=https://graph.facebook.com
GRAPH_VERSION=v27.0
GRAPH_REQUEST_TIMEOUT=15

# ---- Bot behaviour ---------------------------------------------------------
BOT_HANDLE=@remindme.in
DEFAULT_TIMEZONE=Europe/Istanbul
DEFAULT_LOCALE=tr
MAX_COMMENT_CHARS=300
MAX_NOTE_CHARS=140
MIN_DELAY_SECONDS=60
MAX_DELAY_DAYS=365
MAX_ACTIVE_PER_USER=20
# Reply right away with the time the bot understood.
CONFIRM_REPLY=true
# Reply with a usage hint when no time could be parsed (off = stay silent).
REPLY_ON_UNPARSED=false

# ---- Sending ---------------------------------------------------------------
SEND_INTERVAL_SECONDS=2
SEND_MAX_PER_HOUR=100
SEND_BATCH_SIZE=20
INBOX_BATCH_SIZE=25
MAX_ATTEMPTS=6
RETRY_BASE_SECONDS=60
RETRY_MAX_SECONDS=3600
POLL_INTERVAL_SECONDS=15

# Parse and store everything, but never POST to Instagram. Use before App Review.
DRY_RUN=false
